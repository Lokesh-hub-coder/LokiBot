# Leave empty for local development; Vite proxies /chat to FastAPI on 127.0.0.1:8001.
# In Vercel, set NEXT_PUBLIC_API_URL to the HTTPS origin of the deployed FastAPI service.
NEXT_PUBLIC_API_URL=
# Backwards-compatible alias for non-Vercel deployments.
VITE_API_URL=
# Optional local override if FastAPI listens on another port.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8001
